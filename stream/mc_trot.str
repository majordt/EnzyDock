************************************************************
* Perform MC translations and rotations                    *
************************************************************
*

! Weights are chosen such that each degree of freedom has roughly equal
! frequency of being chosen.
! Rigid body translations of ligand
move add mvtp rtrn byresidue weight 1.00 dmax 1.00 label atrn sele segid ligand_@currligand end

! Rigid body rotations of ligand
move add mvtp rrot byresidue weight 1.00 dmax 30.0 label arot sele segid ligand_@currligand end

! Torsional rotations in ligand. Lines below first must be modified manually.
!move add mvtp tors weight 1.00 dmax 180.0 label tr1  fewer 0 sele atom FLX1 1 @protlink1 @debugshow end sele atom ligand_@currligand 1 @atomlink1 @debugshow end
!move add mvtp tors weight 1.00 dmax 180.0 label tr16 fewer 0 sele atom ligand_@currligand 1 O31 @debugshow end sele atom ligand_@currligand 1 C32 @debugshow end

! Only select waters near ligand
if tagwexp .eq. true then
   define wlig sele .byres. ((segid EWAT .and. type OH2) .and. ((segid ligand_@currligand .and. .not. hydrogen) .around. 5.0)) end
   set qwlig false
   if ?nsel .gt. 0 then
      set qwlig true 
   endif
!if tagwexp .eq. true then
   if qwlig .eq. true then
      ! Rigid body translations of explicit waters
      move add mvtp rtrn byresidue weight 1.00 dmax 1.00 label wtrn sele wlig end
      ! Rigid body rotations of explicit waters
      move add mvtp rrot byresidue weight 1.00 dmax 360.0 label wrot sele wlig end
   endif
endif

! Link moves so they are done together.
! Remove for CHARMM-GUI until all MC bugs cleared
if smartmc .eq. true then
   move link lab1 atrn lab2 arot
   if tagwexp .eq. true then
      if qwlig .eq. true then
         move link lab1 wtrn lab2 wrot
      endif
   endif
endif

!open write unformatt unit 11 name @scrDIR/@MOD.@Tf.mc.@j.@s.dcd      ! write trajectory file

stream @strDIR/seed.str

set idomcfrq 5
if @idomcfrq .gt. @mcsteps then 
   set idomcfrq 1
endif

! Do MC simulation
if @microiter .le. 1 then
   write title unit 33
* single t mc_trot (in protein or to align to a docked state with mcs)
*
endif

! save dcd
set iuncrd 11
set nsavc 1
!set dcdidx g_rigid_@currligand_@iter_@microiter
!open write unformatt unit @iuncrd name @scr2DIR/@runid_@gridsize_@deltagrid_@flexibledocking_@flexibleback_@dcdidx.dcd
open write unformatt unit @iuncrd name @scr2DIR/@runid_@gridsize_@deltagrid_@flexibledocking_@flexibleback.dcd

mc temperature @mctemp nsteps @trotmcsteps -
   iseed @seed1 @seed2 @seed3 @seed4 -
   idomcfrq @idomcfrq inbfrq 0 imgfrq 0 iecheck 0 -
   iuncrd @iuncrd nsavc @nsavc

! re-read the dcd file to retrieve the lowest energy structure
!open read unfo unit 11 name @scr2DIR/@runid_@gridsize_@deltagrid_@flexibledocking_@flexibleback_@dcdidx.dcd ! read trajectory file
open read unfo unit 11 name @scr2DIR/@runid_@gridsize_@deltagrid_@flexibledocking_@flexibleback.dcd ! read trajectory file

traj query unit 11

traj firstu 11 nunit 1 skip 1
calc NTot = ?nfile   ! Number of structures in file (from query)

set mcount 1             ! Counter
set mcener 99999999.0   ! Initial lowest energy
set lowidx 1

prnlev @sillev
label rigid_mcmin_loop

   traj read   ! Read structure

   ! Update non-bonded list
   update atom eps @eps @dielec cutnb @ctnb ctofnb @ctfnb ctonnb @ctonb -
          vswitch switch @softon

   gete  ! Get energy
   ! Avoid null coordinates if the initial guess is too low;
   ! Especially important when part of the cofactor lies outside the grid boundaries.
   if @mcount .eq. 1 then
      coor copy comp
      set mcener ?ener
   endif
   if mcener .le. ?ener goto rigid_mcnext
      coor copy comp
      set mcener ?ener
      set lowidx @mcount
   label rigid_mcnext
   incr mcount

if mcount .lt. @NTot goto rigid_mcmin_loop
prnlev 5

write title unit 33
* lowest e after rigid trans-rot was found after @lowidx steps out of @mcount
*

coor copy   ! Copy lowest structure back to main coordinate set

! Remove for CHARMM-GUI until all MC bugs cleared
if smartmc .eq. true then
   if tagwexp .eq. true then
      if qwlig .eq. true then
         move link lab1 wtrn
      endif
   endif
   move link lab1 atrn
endif
move dele label atrn
move dele label arot

if tagwexp .eq. true then
   if qwlig .eq. true then
      move dele label wtrn
      move dele label wrot
   endif
endif

return

